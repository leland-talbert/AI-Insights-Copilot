# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Postgres + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
DEFAULT_WORKSPACE=demo

# Models
DEFAULT_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval
TOP_K=6
MIN_SIMILARITY=0.25

# Arize Phoenix (UI at http://localhost:6006)
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=ai-insights-copilot

# Optional local model via Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
